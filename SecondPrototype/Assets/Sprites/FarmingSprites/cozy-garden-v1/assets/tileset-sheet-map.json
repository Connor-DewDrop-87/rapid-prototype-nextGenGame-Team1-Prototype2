    "shade": "lower-right",
    "near_black_ink": "structures only"
  },
  "grass_arrangements": {
    "tiles/grass_meadow.png": {
      "density": "sparse"
    },
    "tiles/grass_clover.png": {
      "density": "medium"
    },
    "tiles/grass_blossom.png": {
      "density": "medium"
    },
    "tiles/grass_moss.png": {
      "density": "dense"
    },
    "tiles/grass_sprigs.png": {
      "density": "sparse"
    },
    "tiles/grass_leafy.png": {
      "density": "medium"
    }
  },
  "water_detail_rule": {
    "ripple_marks_per_tile": 3,
    "placement": "fixed mask-indexed offsets around the water-body centre; see RIPPLE_LAYOUTS in source/generate_pack.py",
